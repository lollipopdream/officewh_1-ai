# ─── LLM / AI Chat ────────────────────────────────────────────────────────────
# Required for /api/chat to call OpenAI.
# If unset, the kiosk falls back to the deterministic local advice builder.
OPENAI_API_KEY=""
# Optional: Model name ('gpt-4o-mini' is default, ultra-fast & low cost; or 'gpt-4o')
OPENAI_MODEL="gpt-4o-mini"

# ─── Admin Console PIN ────────────────────────────────────────────────────────
# 4–8 digit numeric PIN protecting the /admin route.
NEXT_PUBLIC_ADMIN_PIN=1234

# ─── Live Camera ─────────────────────────────────────────────────────────────
# Note: Live camera feature is removed per client specification.


# ─── Google Chat Integration ──────────────────────────────────────────────────
# When a customer calls staff or requests assistance from the kiosk, an alert card is sent.
# Format: https://chat.googleapis.com/v1/spaces/XXXXX/messages?key=...&token=...
GOOGLE_CHAT_WEBHOOK_URL=

# ─── Base URL (optional) ──────────────────────────────────────────────────────
# Set this if the site is deployed at a custom domain.
# Example: NEXT_PUBLIC_BASE_URL=https://salomon-takao.vercel.app
# NEXT_PUBLIC_BASE_URL=
